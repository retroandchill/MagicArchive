<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        
        <!-- This project is meta package -->
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeContentInPack>true</IncludeContentInPack>
        <NoWarn>$(NoWarn);NU5128</NoWarn>

        <!-- NuGet -->
        <IsPackable>true</IsPackable>
        <PackageTags>serializer</PackageTags>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\MagicArchive.Core\MagicArchive.Core.csproj" />
      <ProjectReference Include="..\MagicArchive.SourceGenerator\MagicArchive.SourceGenerator.csproj" />
    </ItemGroup>

</Project>
